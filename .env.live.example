# Optional CLI defaults. Desktop users configure services in Settings instead.
# Copy to .env.live locally; never commit credentials.
ZSJH_LIVE_MODEL_ENDPOINT=https://api.deepseek.com
ZSJH_LIVE_MODEL_PROVIDER=deepseek
ZSJH_LIVE_MODEL_NAME=
ZSJH_LIVE_MODEL_API_KEY=
ZSJH_WB_MODEL_APPROVED=false
ZSJH_WB_SEARCH_APPROVED=false
ZSJH_WB_AUDIO_APPROVED=false
ZSJH_WB_MODEL_REQUEST_LIMIT=unlimited
ZSJH_WB_SEARCH_REQUEST_LIMIT=unlimited
ZSJH_WB_SEARCH_PROVIDER=tavily
ZSJH_WB_SEARCH_ENDPOINT=https://api.tavily.com
ZSJH_WB_SEARCH_API_KEY=
# Meeting files are retained until the user explicitly deletes the meeting.
